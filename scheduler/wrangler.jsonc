{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "learn-ai-scheduler",
	"main": "index.js",
	"compatibility_date": "2026-09-26",
	"triggers": { "crons": ["*/15 * * * *"] },
	"vars": { "GITHUB_REPO": "ratishjain12/ai-engineering-notes" },
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true }
}
