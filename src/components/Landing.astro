---
const steps = [
	{ title: 'One topic at a time', body: 'Small, focused and explained from first principles, so you can read it over coffee.' },
	{ title: 'Real resources', body: 'The papers, videos and posts I actually learned from, linked on every page.' },
	{ title: 'Figured out as we go', body: 'There is no fixed syllabus. The next topic is whatever is worth understanding next.' },
];

const weights = [
	{ y: 28, w: 5, o: 1, r: 9, label: '0.62' },
	{ y: 76, w: 2.4, o: 0.55, r: 7, label: '0.24' },
	{ y: 124, w: 1.4, o: 0.4, r: 5.5, label: '0.10' },
	{ y: 172, w: 0.8, o: 0.3, r: 4, label: '0.04' },
];
---

<div id="landing" class="not-content mx-auto max-w-[calc(60rem+2rem)] px-4 pb-16 pt-6 text-fg-muted">
	<section class="grid items-center gap-10 border-b border-line pb-12 pt-12 lg:grid-cols-[1.3fr_1fr]">
		<div class="grid gap-5">
		<p class="font-mono text-xs uppercase tracking-widest text-brand-text">Learning AI engineering in public</p>
		<h1 class="font-serif text-[clamp(2.1rem,4vw,3.2rem)] font-medium leading-[1.05] tracking-tight text-fg">
			Learn AI engineering,<br /><em class="text-brand-text">one topic at a time.</em>
		</h1>
		<p class="max-w-xl text-lg leading-relaxed text-fg-muted">
			I write up one AI engineering topic at a time: what I understood and the resources I used. Follow along as it
			grows.
		</p>
		<div class="mt-2 flex flex-wrap gap-3">
			<a
				href="/llms/attention/"
				class="inline-flex min-h-11 cursor-pointer items-center rounded-lg border border-brand-solid bg-brand-solid px-5 font-medium text-on-solid no-underline transition-colors hover:border-brand-solid-hover hover:bg-brand-solid-hover"
			>
				Start with Day 1: Attention
			</a>
		</div>
		</div>

		<svg
			viewBox="0 0 380 200"
			role="img"
			aria-label="A query token attending to four key tokens with different weights"
			class="w-full max-w-md justify-self-center lg:justify-self-end"
		>
			{
				weights.map((p) => (
					<>
						<line x1="70" y1="100" x2="290" y2={p.y} stroke-width={p.w} opacity={p.o} stroke-linecap="round" class="stroke-fg" />
						<circle cx="302" cy={p.y} r={p.r} opacity={p.o} class="fill-fg" />
						<text x="320" y={p.y + 4} class="fill-fg-subtle font-mono text-[11px]">
							{p.label}
						</text>
					</>
				))
			}
			<circle cx="58" cy="100" r="13" class="fill-brand-solid" />
			<text x="58" y="136" text-anchor="middle" class="fill-fg-subtle font-mono text-[11px]">query</text>
		</svg>
	</section>

	<section class="grid gap-8 py-10 sm:grid-cols-3">
		{
			steps.map((s, i) => (
				<div>
					<span class="font-mono text-xs text-brand-text">{String(i + 1).padStart(2, '0')}</span>
					<h3 class="mb-1.5 mt-1.5 font-serif text-[1.35rem] font-medium text-fg">{s.title}</h3>
					<p class="leading-relaxed text-fg-muted">{s.body}</p>
				</div>
			))
		}
	</section>

	<section class="border-t border-line pt-10">
		<h2 class="mb-2 font-serif text-2xl font-medium text-fg">Compare notes</h2>
		<p class="max-w-xl leading-relaxed">
			I share what I'm learning as I go. If you're on the same path, or spot something I got wrong, I'm
			<a href="https://x.com/ratishtwts" class="text-brand-text">@ratishtwts</a> on X.
		</p>
	</section>
</div>
